# Production requires HTTPS for secure session cookies. Terminate TLS at your reverse proxy.
# Environment values must be passed by your deployment; this file is not auto-loaded.
NODE_ENV=production
APP_ORIGIN=https://undoproof.example.com
PORT=3000
HOST=0.0.0.0
DATA_DIR=/app/data
# For built-app localhost development use NODE_ENV=development, PORT=3001,
# DATA_DIR=./data and APP_ORIGIN=http://localhost:3001.
# For Vite live development use APP_ORIGIN=http://localhost:5173 (backend PORT=3001).
# Set to 1 only when the server is reachable exclusively through one trusted reverse proxy.
# Keep 0 for direct connections; incorrect values permit forged client addresses.
TRUST_PROXY_HOPS=0
